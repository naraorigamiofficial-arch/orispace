# Database connection (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/orispace"

# The email address that becomes the admin account when it signs up
ADMIN_EMAIL="you@example.com"

# Public address of the site, used in email links
APP_URL="http://localhost:3000"

# Email sending through Resend. Leave empty in development: emails are printed in the terminal instead.
RESEND_API_KEY=""
EMAIL_FROM="ORISPACE <hello@example.com>"
